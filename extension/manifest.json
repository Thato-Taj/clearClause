{
  "manifest_version": 3,
  "name": "ClearClause",
  "version": "1.1.0",
  "description": "Check terms, contracts and privacy policies against South African law (POPIA, CPA, NCA and more), in plain language.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Check this page with ClearClause",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clearclause@local.dev",
      "strict_min_version": "109.0"
    }
  }
}
