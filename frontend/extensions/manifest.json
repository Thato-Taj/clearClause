{
  "manifest_version": 3,
  "name": "ClearClause",
  "version": "1.0.0",
  "description": "Democratize legal literacy, spot POPI Act violations, and simplify terms of service using AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clearclause@local.dev",
      "strict_min_version": "109.0"
    }
  }
}