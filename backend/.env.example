# ── Server ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
# Public URL of the website (used in links the bots send)
WEB_APP_URL=http://localhost:3000
# Public URL of this API (production; used to register the Telegram webhook)
PUBLIC_API_URL=
# Comma-separated list of website origins allowed to call the API. Browser extensions are always allowed.
CORS_ORIGINS=http://localhost:3000
# Long random string. Used to pseudonymise IPs, phone numbers and chat ids before storage.
HASH_SALT=change-me-to-a-long-random-string

# ── AI (Google Gemini) ────────────────────────────────────────────────────
GEMINI_API_KEY=
# gemini-3.7/3.8-flash are smarter but often too busy on the free tier; worth trying on a paid key.
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is busy, slow or out of free quota (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
MAX_DOCUMENT_CHARS=200000
MAX_UPLOAD_MB=10

# ── Firebase Admin (Auth + Firestore) ─────────────────────────────────────
# Either point to the service-account file…
FIREBASE_SERVICE_ACCOUNT_PATH=./src/serviceAccountKey.json
# …or paste the whole JSON on one line (easier on Render/Railway)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Scan allowance per plan ──────────────────────────────────────────────
# Rolling window: each scan counts for *_DAYS days after it was used, then frees up.
# -1 = unlimited. QUOTA_ANON=0 makes guests sign in before scanning.
# Guests (by IP) and WhatsApp/Telegram users get the guest/free allowance.
QUOTA_ANON=3
QUOTA_ANON_DAYS=14
QUOTA_FREE=3
QUOTA_FREE_DAYS=14
QUOTA_PRO=50
QUOTA_PRO_DAYS=1
QUOTA_BUSINESS=-1

# ── Telegram (create a bot with @BotFather) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ClearClauseBot
# polling = local dev (no public URL needed); webhook = production
TELEGRAM_MODE=polling
# Random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=

# ── WhatsApp (Meta Cloud API — developers.facebook.com → WhatsApp) ────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; enter the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# App Dashboard → Settings → Basic → App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
# Number shown on the website, e.g. 27821234567
WHATSAPP_DISPLAY_NUMBER=
